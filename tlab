def show_monitor():
    print(render_hud())

def show_live():
    try:
        with Live(render_hud(), console=console, screen=True, refresh_per_second=2) as live:
            while True:
                live.update(render_hud())
                time.sleep(2)
    except KeyboardInterrupt:
        pass

def main():
    args = sys.argv[1:]
    if not args or args[0] in ("help", "--help", "-h"):
        show_help()
        return
    cmd = ALIASES.get(args[0], args[0])
    extra = args[1:]
    if cmd == "status":
        show_status()
    elif cmd == "monitor":
        show_monitor()
    elif cmd == "live":
        show_live()
    elif cmd == "backtest":
        validate_backtest_args(extra)
        run_script(COMMANDS[cmd][0], extra)
    elif cmd in COMMANDS:
        run_script(COMMANDS[cmd][0], extra)
    else:
        print(f"✗ Comando sconosciuto: {args[0]}")
        sys.exit(1)

if __name__ == "__main__":
    main()
