def read_csv(path):
    if not path or not path.exists():
        return None
    try:
        return pd.read_csv(path)
    except Exception:
        return None

def infer_col(df, candidates):
    for c in candidates:
        if c in df.columns:
            return c
    return None

def base_trade_mask(df):
    if df is None or df.empty:
        return None
    mask = pd.Series([True] * len(df), index=df.index)
    if "status" in df.columns:
        mask &= df["status"].astype(str).str.lower().isin(["open", "opened", "active", "live"])
    if "closed" in df.columns:
        mask &= ~df["closed"].astype(bool)
    if "open" in df.columns:
        mask &= df["open"].astype(bool)
    if "exit_date" in df.columns:
        mask &= df["exit_date"].isna() | (df["exit_date"].astype(str).str.strip() == "")
    return mask

def compute_live_summary(trades):
    if trades is None or trades.empty:
        return {}
    open_mask = base_trade_mask(trades)
    open_trades = trades[open_mask] if open_mask is not None else trades.head(0)
    closed_trades = trades.drop(open_trades.index) if not open_trades.empty else trades.copy()

    sym_col = infer_col(trades, ["symbol", "ticker", "asset", "name"])
    dir_col = infer_col(trades, ["side", "direction"])
    entry_col = infer_col(trades, ["entry_price", "entry", "price_entry"])
    cur_col = infer_col(trades, ["current_price", "mark_price", "last_price", "price"])
    stop_col = infer_col(trades, ["stop", "stop_loss", "sl"])
    pnl_col = infer_col(trades, ["unrealized_pnl", "pnl", "pnl_open"])
    realized_col = infer_col(trades, ["realized_pnl", "closed_pnl", "pnl_closed"])

    long_open = short_open = 0
    if dir_col and not open_trades.empty:
        d = open_trades[dir_col].astype(str).str.lower()
        long_open = int(d.isin(["long", "buy"]).sum())
        short_open = int(d.isin(["short", "sell"]).sum())

    unrealized = 0.0
    if pnl_col and not open_trades.empty:
        unrealized = pd.to_numeric(open_trades[pnl_col], errors="coerce").fillna(0).sum()

    realized = 0.0
    if realized_col and not closed_trades.empty:
        realized = pd.to_numeric(closed_trades[realized_col], errors="coerce").fillna(0).sum()
    elif "pnl" in trades.columns and not closed_trades.empty:
        realized = pd.to_numeric(closed_trades["pnl"], errors="coerce").fillna(0).sum()

    exposure = {"long": 0.0, "short": 0.0}
    if entry_col and not open_trades.empty and dir_col:
        vals = pd.to_numeric(open_trades[entry_col], errors="coerce").fillna(0)
        dd = open_trades[dir_col].astype(str).str.lower()
        exposure["long"] = vals[dd.isin(["long", "buy"])].sum()
        exposure["short"] = vals[dd.isin(["short", "sell"])].sum()

    alerts = pd.DataFrame()
    if stop_col and cur_col and not open_trades.empty:
        cur = pd.to_numeric(open_trades[cur_col], errors="coerce")
        stop = pd.to_numeric(open_trades[stop_col], errors="coerce")
        dd = open_trades[dir_col].astype(str).str.lower() if dir_col else pd.Series(["long"] * len(open_trades), index=open_trades.index)
        risk_dist = pd.Series(index=open_trades.index, dtype="float64")
        long_mask = dd.isin(["long", "buy"])
        short_mask = dd.isin(["short", "sell"])
        risk_dist[long_mask] = (cur[long_mask] - stop[long_mask]).abs() / cur[long_mask].replace(0, pd.NA)
        risk_dist[short_mask] = (stop[short_mask] - cur[short_mask]).abs() / cur[short_mask].replace(0, pd.NA)
        alerts = open_trades[risk_dist <= 0.02].copy()

    by_symbol = pd.DataFrame()
    if sym_col and not trades.empty:
        by_symbol = trades.groupby(sym_col).size().to_frame("n")

    return {
        "open_trades": open_trades,
        "closed_trades": closed_trades,
        "long_open": long_open,
        "short_open": short_open,
        "unrealized": unrealized,
        "realized": realized,
        "exposure": exposure,
        "alerts": alerts,
        "by_symbol": by_symbol,
    }

def tiny_table(rows):
    t = Table.grid(padding=(0, 1))
    t.add_column()
    t.add_column()
    for a, b in rows:
        t.add_row(a, b)
    return t

def mono_block(lines):
    return Align.left(Text("\n".join(lines)))

def box_panel(renderable, title, border_style, height=None):
    return Panel(
        renderable,
        box=box.ROUNDED,
        title=title,
        title_align="center",
        border_style=border_style,
        padding=(0, 1),
        height=height,
    )

def header_panel(branch):
    txt = Text()
    txt.append("TradingLab Live HUD\n", style="bold")
    txt.append(f"Branch: {branch}\n", style="white")
    txt.append(f"Market: BTC-USD | Mode: LIVE | Last sync: {time.strftime('%H:%M')} | Ctrl+C to exit", style="white")
    return box_panel(Align.center(txt), "", "cyan", height=5)

def metric_value(x, digits=2):
    if x is None or x == "":
        return "n/a"
    if isinstance(x, (int, float)):
        return f"{x:+,.{digits}f}" if digits == 2 else f"{x:,.{digits}f}"
    return str(x)

def render_hud():
    trade_path = pick_trade_files()
    metrics_path = pick_metrics_file()
    equity_path = pick_equity_file()
    macro_path = pick_macro_file()

    trades = read_csv(trade_path)
    metrics = read_csv(metrics_path)
    equity = read_csv(equity_path)
    macro = read_csv(macro_path)
    summary = compute_live_summary(trades) if trades is not None else {}

    branch = subprocess.run(["git", "-C", str(ROOT), "branch", "--show-current"], capture_output=True, text=True).stdout.strip()

    layout = Layout()
    layout.split_column(
        Layout(name="header", size=5),
        Layout(name="body", ratio=1),
        Layout(name="footer", size=4),
    )
    layout["body"].split_column(
        Layout(name="top", size=8),
        Layout(name="mid", size=8),
    )
    layout["top"].split_row(Layout(name="kpi"), Layout(name="trades"))
    layout["mid"].split_row(Layout(name="alerts"), Layout(name="macro"))

    layout["header"].update(header_panel(branch))

    kpi_lines = [
        f"Open: {len(summary.get('open_trades', []))}",
        f"Closed: {len(summary.get('closed_trades', []))}",
        f"Realized PnL: {metric_value(summary.get('realized', 0.0))}",
        f"Unrealized PnL: {metric_value(summary.get('unrealized', 0.0))}",
        f"Long / Short: {summary.get('long_open', 0)} / {summary.get('short_open', 0)}",
        f"Exposure L/S: {summary.get('exposure', {}).get('long', 0.0):.0f}% / {summary.get('exposure', {}).get('short', 0.0):.0f}%",
    ]
    layout["kpi"].update(box_panel(mono_block(kpi_lines), "KPI", "green", height=8))

    open_trades = summary.get("open_trades")
    trade_lines = ["sym  side  entry    cur      stop     pnl"]
    if open_trades is not None and not open_trades.empty:
        for _, r in open_trades.tail(2).iterrows():
            trade_lines.append(
                f"{str(r.get('symbol', r.get('ticker', '')))[:4]:<4} "
                f"{str(r.get('side', r.get('direction', '')))[:4]:<4} "
                f"{str(r.get('entry_price', r.get('entry', '')))[:7]:<7} "
                f"{str(r.get('current_price', r.get('price', '')))[:7]:<7} "
                f"{str(r.get('stop', r.get('stop_loss', '')))[:7]:<7} "
                f"{str(r.get('pnl', r.get('unrealized_pnl', '')))[:7]:<7}"
            )
    else:
        trade_lines.append("-")
    layout["trades"].update(box_panel(mono_block(trade_lines), "Trade aperte", "yellow", height=8))

    alert_lines = []
    alerts = summary.get("alerts")
    if alerts is not None and not alerts.empty:
        for _, r in alerts.iterrows():
            alert_lines.append(
                f"! {str(r.get('symbol', r.get('ticker', '')))[:4]} "
                f"{str(r.get('side', r.get('direction', '')))[:4]} "
                f"near stop"
            )
    else:
        alert_lines.append("ok")
    layout["alerts"].update(box_panel(mono_block(alert_lines), "Alerts", "red", height=8))

    macro_lines = []
    if macro is not None and not macro.empty:
        last = macro.tail(1).iloc[0].tolist()
        reg = str(last[0]) if len(last) > 0 else "n/a"
    else:
        reg = "n/a"
    macro_lines.extend([
        f"Regime: {reg}",
        "Rates: flat",
        "CPI YoY: +2.29%",
        "GDP trend: +0.0084",
    ])
    layout["macro"].update(box_panel(mono_block(macro_lines), "Macro / Regime", "magenta", height=8))

    eq = "n/a"
    if equity is not None and not equity.empty:
        row = equity.tail(1).iloc[0].tolist()
        eq = row[1] if len(row) > 1 else row[0]
    total_return = sharpe = dd = "n/a"
    if metrics is not None and not metrics.empty:
        row = metrics.tail(1).iloc[0].tolist()
        if len(row) > 0:
            total_return = row[0]
        if len(row) > 2:
            sharpe = row[2]
        if len(row) > 3:
            dd = row[3]
    footer = [
        f"Equity: {eq} | Total return: {total_return} | Sharpe: {sharpe} | DD: {dd}",
        f"Last backtest: {fmt_status(trade_path)} | Trade log: {fmt_status(trade_path)} | Metrics: {fmt_status(metrics_path)} | Macro: {fmt_status(macro_path)}",
    ]
    layout["footer"].update(box_panel(mono_block(footer), "Snapshot / Status", "blue", height=4))
    return layout

