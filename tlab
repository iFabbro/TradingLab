def run_script(script_name, extra_args):
    script_path = SCRIPTS / script_name
    if not script_path.exists():
        print(f"✗ Script non trovato: {script_path}")
        sys.exit(1)
    cmd = [sys.executable, str(script_path)] + extra_args
    result = subprocess.run(cmd, cwd=ROOT)
    sys.exit(result.returncode)

def validate_backtest_args(extra_args):
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--prices", required=True)
    known, _ = parser.parse_known_args(extra_args)
    prices_path = (ROOT / known.prices).expanduser()
    if not prices_path.exists():
        print(f"✗ File prezzi non trovato: {prices_path}")
        sys.exit(1)

